{
  "expo": {
    "name": "projForm",
    "slug": "projForm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./imagens/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./imagens/android-icon-foreground.png",
        "backgroundImage": "./imagens/android-icon-background.png",
        "monochromeImage": "./imagens/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./imagens/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
